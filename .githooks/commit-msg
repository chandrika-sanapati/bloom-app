#!/usr/bin/env bash
# Strip Cursor attribution trailers so agent commits stay author-only.
set -euo pipefail

msg_file="${1:-}"
if [[ -z "$msg_file" || ! -f "$msg_file" ]]; then
  exit 0
fi

tmp="$(mktemp)"
# Drop Co-authored-by / Made-with lines that attribute Cursor.
grep -viE '^[[:space:]]*(Co-authored-by:[[:space:]]*Cursor([[:space:]]*<[^>]*>)?|Made-with:[[:space:]]*Cursor)[[:space:]]*$' \
  "$msg_file" >"$tmp" || true

# Trim trailing blank lines left after removal.
perl -i -0pe 's/\n+\z/\n/' "$tmp"
mv "$tmp" "$msg_file"
