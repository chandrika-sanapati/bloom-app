# Local-only secrets. Copy to `.env` (gitignored) and fill in values.
# Never commit real keys. Prefer a Bloom proxy for anything beyond personal debug.

# Closed-beta / local debug only — do not ship in release APKs.
BLOOM_PLANTNET_API_KEY=

# Preferred for production/internal builds (server holds the vendor key).
BLOOM_IDENTIFY_PROXY_URL=
