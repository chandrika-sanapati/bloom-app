# Local-only secrets. Copy to `.env` (gitignored) and fill in values.
# Never commit real keys.

# Preferred: Bloom identify proxy origin (no trailing path).
# Local Worker via emulator → host: http://10.0.2.2:8787
# Deployed Worker: https://bloom-identify-proxy.<subdomain>.workers.dev
# When set, leave BLOOM_PLANTNET_API_KEY empty.
BLOOM_IDENTIFY_PROXY_URL=

# Optional Bearer token; must match Worker secret BLOOM_APP_TOKEN if enabled.
BLOOM_IDENTIFY_APP_TOKEN=

# Closed-beta / personal debug only — do not ship in release APKs.
# Prefer the proxy above for anything shared or store-bound.
BLOOM_PLANTNET_API_KEY=
